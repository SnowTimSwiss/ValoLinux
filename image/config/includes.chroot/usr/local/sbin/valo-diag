#!/bin/sh
# Test-image diagnostics: write login-related state into /etc/issue so it is visible at the console login prompt.
out=/etc/issue
{
  echo "ValoLinux DIAG ($(date -Is))"
  for u in user valo root; do
    if getent passwd "$u" >/dev/null; then
      # print only account status, never hashes
      echo "acct $u: $(passwd -S "$u" 2>&1)"
    else
      echo "acct $u: MISSING"
    fi
  done
  echo "pam pkgs: $(dpkg-query -W -f='${Package}=${Version} ' libpam-modules libpam-modules-bin libpam-runtime login passwd 2>&1)"
  echo "common-auth pam_unix: $(grep -c pam_unix /etc/pam.d/common-auth 2>&1)"
  echo "live-config: $(systemctl is-active live-config.service 2>&1)"
  echo "lightdm: $(systemctl is-active lightdm.service 2>&1)"
  echo "xfce4-session: $(dpkg-query -W -f='${Version}' xfce4-session 2>&1)"
  echo "apps: $(dpkg-query -W -f='${Package}=${Version} ' wordcraft gridcraft deckcraft firefox-esr 2>&1)"
  journalctl -b -p warning --no-pager -n 15 2>/dev/null | cut -c1-110
  echo
} > "$out.diag"
cat "$out.diag" /etc/issue.orig 2>/dev/null > "$out" || cp "$out.diag" "$out"
